    18: 000005   2ED0  mov   r13,r16  ;Valor que será somado ao input de frequência para ajustar o Prescaler (00 -> 010 (8) ; 01 -> 011 (64) ; ...)
    19: 000006   E111  ldi   r17,0x11          ;Carrega r17 com 17
