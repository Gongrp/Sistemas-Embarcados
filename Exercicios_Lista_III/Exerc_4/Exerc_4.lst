    26: read_inputs:
    27: 00000A   B103  in    r16,PINB
    28: 00000B   1302  cpse  r16,r18
    29: 00000C   C001  rjmp  adjust_params ;Se houver diferença no valor anterior de PINB e no detectado, muda a configuração do PWM
    30: 00000D   CFFC  rjmp  read_inputs   ;Se for igual ao anterior, não ajusta de novo, continua conferindo
    31: 
    32: adjust_params:
    33: 
    34: ;Ajuste de Duty Cycle
    35: 00000E   2F40  mov   r20,r16
    36: 00000F   734C  andi  r20,0b00_1111_00  ;Máscara mantém apenas os bits de configuração do Duty cycle (PB2:PB5)
    37: 000010   9546  lsr   r20
    38: 000011   9546  lsr   r20               ;Alinha o final com o bit zero (0:3)
    39: 000012   9F41  mul   r20,r17           ;Ao multiplicar um valor em resolução de 4 bits por d17, chegamos a um valor em resolução de 8 bits -> 15 x 17 = 255)
    40: ;O valor do ajuste estará armazenado em (R1:R0). Como terá no máximo 8 bits (255), na verdade apenas R0
    41: 000013   2D40  mov   r20,r0
    42: 
    43: ;Ajuste de frequência
