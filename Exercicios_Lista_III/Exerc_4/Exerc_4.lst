    45: 000015   7033  andi  r19,0b00_0000_11  ;Máscara mantém apenas os bits (PB0:PB1)
    46: 000016   0D3D  add   r19,r13           ;Soma com constante (10) para converter da seleção de input direto pro código de PS correspondente
    47: 
    48: 
    49: set_parameters:
    50: 000017   BD35  out  TCCR0B,r19        ;Configura frequência (opções de PS 8, 64, 256 e 1024)
    51: 000018   BD47  out  OCR0A,r20          ;Configura duty cycle (0-255)
    52: 000019   2F20  mov  r18,r16           ;Registra novo ajuste como ajuste anterior para comparar no próximo ciclo
    53: 00001A   CFEF  rjmp read_inputs       ;Reinicia ciclo
